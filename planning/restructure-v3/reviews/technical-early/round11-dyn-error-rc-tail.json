  "concept_evidence": [
    {
      "source": "docs/chapters/11-06-lesson.md:27",
      "judgment": "dyn trait object、DST、&dyn借用與unsizing coercion在首用前；Vec元素仍只有一種Box<dyn Charge>。沒有把共同trait當成相同具體型別，也沒有說enum不能完成相同工作。"
    },
    {
      "source": "docs/chapters/11-06-lesson.md:67",
      "judgment": "Charge沒有自身lifetime bound，簽名/欄位Box<dyn Charge>預設static與值壽命分清；&'a dyn Charge/reference object bound及expression推導例外在後段明確補足。"
    },
    {
      "source": "docs/chapters/11-06-lesson.md:69",
      "judgment": "static/dynamic dispatch、monomorphization、vtable在圖前；handle資訊/資料分離不冒稱精確ABI。效能沒有由三個輸出推排名，承認可去虛擬化。"
    },
    {
      "source": "docs/chapters/11-06-lesson.md:113",
      "judgment": "RPIT固定一具體結果、兩closure型別不同、Box dyn Fn共同呼叫及Copy base/static、borrowed object + '_依來源，均對source成立。"
    },
    {
      "source": "docs/chapters/11-06-lesson.md:196",
      "judgment": "dyn compatibility：整體Sized、method泛型、回傳Self、where Self:Sized局部排除、supertrait繼承amount、associated Output equality均先教；完整target未載未教closure/compatibility到早期命令。"
    },
    {
      "source": "docs/chapters/11-07-lesson.md:9",
      "judgment": "Error:Debug+Display、source預設None、Option<&(dyn Error+'static)>的外層reference lifetime與內部bound分清，允許外層borrowed context，source只借owned static原因。"
    },
    {
      "source": "docs/chapters/11-07-lesson.md:73",
      "judgment": "report只追有限無環原因鏈，輸出owned String不延長reference；各層Display只表本層避免重複，資料仍由各error owner持有。"
    },
    {
      "source": "docs/chapters/11-07-lesson.md:166",
      "judgment": "具體Error+'static到Box<dyn Error>的標準From使?可boxing，不錯稱Result本來強制Error；boxed邊界與enum穩定分類各有用途。"
    },
    {
      "source": "docs/chapters/11-08-lesson.md:7",
      "judgment": "Rc計數strong owner而非普通reference；clone只新增同配置handle不Clone T；Deref無DerefMut、movehandle不增count、最後strong清理T準確。"
    },
    {
      "source": "docs/chapters/11-08-lesson.md:54",
      "judgment": "borrowed match value:&i32/next:&Rc、chain=next的Deref coercion在首用前，SharedChain 3→2→1共同尾段與200/160對source。"
    },
    {
      "source": "docs/chapters/11-08-lesson.md:112",
      "judgment": "Weak不保活T、upgrade成功回owned Rc並增strong、空Weak/末strong後None、T與allocation不同清理時點均準確；temporary match使1→2→1可觀測。"
    },
    {
      "source": "docs/chapters/11-08-lesson.md:149",
      "judgment": "strong cycle明稱假設資料圖而非已建立source；雙向strong各1無法啟動drop及memory leak判斷正確，不靠未教RefCell程式補缺口。"
    }
  ],
