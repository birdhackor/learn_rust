  "concept_evidence": [
    {
      "source": "docs/chapters/11-09-lesson.md:19",
      "judgment": "Cell new/get(T:Copy)/set清理舊值/replace交回原owned/into_inner消耗契約在首用前；只限本節操作不聲稱Cell所有API都不借出。"
    },
    {
      "source": "docs/chapters/11-09-lesson.md:74",
      "judgment": "RefCell borrow/borrow_mut runtime規則、Ref/RefMut guard和Drop解除、Deref/DerefMut與來源lifetime在首用前。普通reference最後使用不同於guard最後讀取；panic與try Result路徑分清。"
    },
    {
      "source": "docs/chapters/11-09-lesson.md:145",
      "judgment": "Recorder view仍持Ref guard，需drop才record；Rc owner和RefCell guard計量分清。Weak parent實際樹向下strong、向上Weak，temporary upgrade範圍使branch1/leaf2數字正確。"
    },
    {
      "source": "docs/chapters/11-10-lesson.md:40",
      "judgment": "tuple struct pub欄位/constructor/.0、nonCopy wrapper及alias身分差別先教；本節newtype只單位不做數值驗證。"
    },
    {
      "source": "docs/chapters/11-10-lesson.md:80",
      "judgment": "Add Rhs=Self預設型別參數（非預設body）、Output/self move、Self(...)建構與associated equality bound明確；500mm+2m=2500mm及方向限制正確。"
    },
    {
      "source": "docs/chapters/11-10-lesson.md:142",
      "judgment": "local依crate定義不依import/alias，foreign Display+foreign Vec E0117，本地wrapper或本地trait的合法方向準確；私有欄位和不自動繼承Vec methods有說明。"
    },
    {
      "source": "docs/chapters/11-10-lesson.md:198",
      "judgment": "orphan掃描self再trait type arguments、首local以前uncovered type params、Wrapped<T>及Box fundamental vs Vec cover/local區別均準確；反向From E0210和local blanket重疊E0119對source。"
    },
    {
      "source": "docs/chapters/11-11-lesson.md:9",
      "judgment": "Any型別static bound與這次reference lifetime分清；downcast精確型別不轉換數值。is/downcast helper為dyn Any提供的操作，不誤說成可動態派發generic trait method。"
    },
    {
      "source": "docs/chapters/11-11-lesson.md:57",
      "judgment": "Event Box ownership、impl Any由caller選型別、downcast_ref來源連Event、downcast_mut需mutable借用先教；owned Box不取消短命借用限制。"
    },
    {
      "source": "docs/chapters/11-11-lesson.md:106",
      "judgment": "owned downcast consumes原Box，成功Box<T>/失敗原Box；String可接回再試，取得Box後push並特殊move-out，沒有clone。"
    },
    {
      "source": "docs/chapters/11-11-lesson.md:144",
      "judgment": "TypeId::of/type_id及Box自身Any vs內部dyn Any身分分清，runtime負例確比Box與i32；不把跨Rust版本TypeId表示/hash/order當持久格式。"
    }
  ],
