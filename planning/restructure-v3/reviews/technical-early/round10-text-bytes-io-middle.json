  "concept_evidence": [
    {
      "source": "docs/chapters/10-03-lesson.md:34",
      "judgment": "fs/io、read_to_string、io::Result別名、Error/Debug/Display/kind/ErrorKind與non-exhaustive wildcard在首用前；分類不靠OS錯誤文字。"
    },
    {
      "source": "docs/chapters/10-03-lesson.md:71",
      "judgment": "File::open唯讀取得handle而非完整內容、Read trait import、mutable來源位置、read_to_string追加與新讀入bytes在首用前準確。無效UTF8時給定String不變，其他I/O錯誤可能已有部分讀入的界線正確。"
    },
    {
      "source": "docs/chapters/10-03-lesson.md:99",
      "judgment": "File::create可能清空既有檔案已明說，專用note-output；Write/write!的io::Result<()>與Formatter fmt::Result區別先教。不冒稱持久化保證。"
    },
    {
      "source": "docs/chapters/10-03-lesson.md:117",
      "judgment": "Cargo測試以package根作cwd；ErrorKind Debug/PartialEq而io::Error無PartialEq，所以測試先match再比kind，source一致。"
    },
    {
      "source": "docs/chapters/10-04-lesson.md:9",
      "judgment": "u8 0..255、byte slice/array/Vec、Copy初始化、Read::read有效前段與回傳型別、短讀不等於EOF均在read_all前解釋。"
    },
    {
      "source": "docs/chapters/10-04-lesson.md:27",
      "judgment": "Ok(0)結束明限非空buffer及本輪有限來源，承認檔案後續追加可再讀；Interrupted重試，其餘Err不變完整部分成功。Read::read符合契約的n≤buffer和Err無成功bytes表述準確。"
    },
    {
      "source": "docs/chapters/10-04-lesson.md:45",
      "judgment": "String::from_utf8接手Vec<u8>並分開I/O/UTF8錯誤；完整收集後驗證跨批scalar，沒有逐塊誤解碼。"
    },
    {
      "source": "docs/chapters/10-04-lesson.md:63",
      "judgment": "ShortReader正數max_per_read假設明定；算法min(剩餘資料,buffer,上限)，零長buffer/EOF零，position精準前進。as_bytes/byte slice to_owned的owned Vec角色先教。"
    },
    {
      "source": "docs/chapters/10-04-lesson.md:83",
      "judgment": "PermissionDenied、Error::from(kind)、slice::is_empty先解釋；event state允許在Err後更新而非假裝讀取資料。三次event Interrupted→R→PermissionDenied符合source。"
    },
    {
      "source": "docs/chapters/10-04-lesson.md:101",
      "judgment": "write短寫、write_all重試Interrupted/零進展WriteZero/部分不rollback、flush不保永久儲存都正確；ShortWriter必要flush無中介緩衝故Ok，default write_all即可。"
    },
    {
      "source": "docs/chapters/10-04-lesson.md:190",
      "judgment": "count_bytes答案只累加成功n，四格固定buffer，不建立累積Vec；三fixture分別9/0/1，無UTF8要求。"
    }
